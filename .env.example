# Copy to .env and fill in your own key. .env is gitignored.
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Note: the model is pinned in backend/config.py to gpt-6-luna for every agent.
# PORTKEY_MODEL is intentionally ignored so a stale value cannot swap the model.
